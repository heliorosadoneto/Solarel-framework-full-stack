{
  "apps": [
    {
      "name": "apiDev",

      "script": "dist/src/server.js",

      "watch": true,

      "args": "dev",

      "cwd": "./",

      "env": {
        "NODE_ENV": "development",

        "PORT": 5000
      }
    },
    {
      "name": "apiProd",

      "script": "dist/src/server.js",

      "args": "start",

      "cwd": "./",

      "env_production": {
        "NODE_ENV": "production",

        "PORT": 5000
      }
    }
  ]
}
